{
  "name": "@bootnodedev/cbn",
  "version": "0.1.3",
  "type": "module",
  "description": "Barebones one-click Canton developer stack.",
  "bin": {
    "canton-barebones": "bin/canton-barebones.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/"
  ],
  "scripts": {
    "init": "node ./bin/canton-barebones.js init",
    "start": "node ./bin/canton-barebones.js start",
    "stop": "node ./bin/canton-barebones.js stop",
    "reset": "node ./bin/canton-barebones.js reset",
    "status": "node ./bin/canton-barebones.js status",
    "logs": "node ./bin/canton-barebones.js logs",
    "setup": "node ./bin/canton-barebones.js setup",
    "validate": "node ./bin/canton-barebones.js validate",
    "compose": "node ./bin/canton-barebones.js compose",
    "compose:config": "node ./bin/canton-barebones.js compose config",
    "test": "node --test \"scripts/**/*.test.js\"",
    "test:e2e": "node ./bin/canton-barebones.js init && node ./scripts/smoke.js",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
